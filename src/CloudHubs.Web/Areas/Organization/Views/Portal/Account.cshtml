                                            <button class="btn btn-sm btn-outline-light btn-copy-code" onclick="copySnippet('snippet-curl')">Copy</button>
                                            <pre id="snippet-curl" class="m-0 text-white"><code>curl -X GET "@($"{Context.Request.Scheme}://{Context.Request.Host}/api/organizations/{organization?.Id}/overview")" \
  -H "X-Api-Key: @(Model.OrganizationApiKey ?? "YOUR_API_KEY")" \
  -H "Accept: application/json"</code></pre>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="fw-bold small text-muted mb-2">JavaScript / React (Fetch API): Custom Dashboard Hook</div>
                                        <div class="code-preview-block">
                                            <button class="btn btn-sm btn-outline-light btn-copy-code" onclick="copySnippet('snippet-js')">Copy</button>
                                            <pre id="snippet-js" class="m-0 text-white"><code>const fetchOrgMetrics = async () => {
  const res = await fetch("@($"{Context.Request.Scheme}://{Context.Request.Host}/api/organizations/{organization?.Id}/overview")", {
    headers: {
      "X-Api-Key": "@(Model.OrganizationApiKey ?? "YOUR_API_KEY")",
      "Accept": "application/json"
    }
  });
  const data = await res.json();
  console.log("Projects:", data.projectsCount, "Members:", data.membersCount);
  return data;
};</code></pre>
                                        </div>
                                    </div>
                                </section>
