@model UserFormViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit user" : "Create user";
    ViewData["Section"] = "Users";
}

<section class="page-heading">
    <div><p class="eyebrow">CONTROL PLANE / USERS</p><h1>@ViewData["Title"]</h1><p>Manage the platform user directory record.</p></div>
    <a class="btn btn-outline-secondary" href="/su/users">Back to users</a>
</section>

<form class="surface admin-form" method="post" action="@(isEdit ? $"/su/users/{Model.Id}/edit" : "/su/users/create")">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="All" role="alert"></div>
    }
    <div class="mb-3"><label class="form-label" asp-for="Name">Full name</label><input class="form-control" asp-for="Name" autocomplete="name" required /><span class="text-danger" asp-validation-for="Name"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Email">Email</label><input class="form-control" asp-for="Email" type="email" autocomplete="email" required /><span class="text-danger" asp-validation-for="Email"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Role">Role</label><select class="form-select" asp-for="Role"><option value="OrganizationAdmin">Organization admin</option><option value="Developer">Developer</option><option value="Viewer">Viewer</option></select><span class="text-danger" asp-validation-for="Role"></span></div>
    <div class="form-check mb-4"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">Active</label></div>
    <div class="form-actions"><a class="btn btn-outline-secondary" href="/su/users">Cancel</a><button class="btn btn-success" type="submit">@(isEdit ? "Save changes" : "Create user")</button></div>
</form>