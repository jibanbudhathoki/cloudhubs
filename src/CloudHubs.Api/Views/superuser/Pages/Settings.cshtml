@model PlatformSettingsViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    var section = ViewData["SettingsSection"] as string;
    var isLandingPage = section is null;
    var sectionTitle = ViewData["Title"] as string ?? "Settings";
    var platformName = ViewData["PlatformName"] as string ?? "CloudHubs";
    var pageDescription = isLandingPage
        ? $"Manage {platformName} configuration by category."
        : $"{sectionTitle} configuration.";
    ViewData["Section"] = "Settings";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">CONTROL PLANE / SETTINGS</p>
        <h1>@(isLandingPage ? "Platform settings" : sectionTitle)</h1>
        <p>@pageDescription</p>
    </div>
    @if (!isLandingPage)
    {
        <a class="btn btn-outline-secondary" href="/su/settings">All settings</a>
    }
</section>

<section class="settings-category-grid" aria-label="Settings categories" hidden="@(!isLandingPage)">
        <a class="surface settings-category" href="/su/settings/profile">
            <span class="settings-category-icon" aria-hidden="true">P</span>
            <span><strong>Platform profile</strong><small>Platform name, support contact, and public URL.</small></span>
            <span class="settings-category-arrow" aria-hidden="true">›</span>
        </a>
        <a class="surface settings-category" href="/su/settings/security">
            <span class="settings-category-icon" aria-hidden="true">S</span>
            <span><strong>Security</strong><small>Admin session, API-token lifetime, and password rules.</small></span>
            <span class="settings-category-arrow" aria-hidden="true">›</span>
        </a>
        <a class="surface settings-category" href="/su/settings/organizations">
            <span class="settings-category-icon" aria-hidden="true">O</span>
            <span><strong>Organization defaults</strong><small>Organization creation, status, and trial settings.</small></span>
            <span class="settings-category-arrow" aria-hidden="true">›</span>
        </a>
        <a class="surface settings-category" href="/su/settings/catalog">
            <span class="settings-category-icon" aria-hidden="true">C</span>
            <span><strong>Catalog defaults</strong><small>Default template for new platform projects.</small></span>
            <span class="settings-category-arrow" aria-hidden="true">›</span>
        </a>
        <a class="surface settings-category" href="/su/settings/billing">
            <span class="settings-category-icon" aria-hidden="true">B</span>
            <span><strong>Billing defaults</strong><small>Default plan, currency, and monthly price.</small></span>
            <span class="settings-category-arrow" aria-hidden="true">›</span>
        </a>
        <a class="surface settings-category" href="/su/settings/notifications">
            <span class="settings-category-icon" aria-hidden="true">N</span>
            <span><strong>Notifications</strong><small>Organization-created alert preference and recipient.</small></span>
            <span class="settings-category-arrow" aria-hidden="true">›</span>
        </a>
    </section>

@if (!isLandingPage)
{
    <form class="surface admin-form settings-section-form" method="post" action="@($"/su/settings/{section}")">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" asp-validation-summary="All" role="alert"></div>
        }

        @switch (section)
        {
            case "profile":
                <p class="settings-section-description">Identity and contact information shown across the platform.</p>
                <div class="mb-3">
                    <label class="form-label" asp-for="PlatformName">Platform name</label>
                    <input class="form-control" asp-for="PlatformName" required />
                    <span class="text-danger" asp-validation-for="PlatformName"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="SupportEmail">Support email</label>
                    <input class="form-control" asp-for="SupportEmail" type="email" autocomplete="email" />
                    <span class="text-danger" asp-validation-for="SupportEmail"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="PublicUrl">Public platform URL</label>
                    <input class="form-control" asp-for="PublicUrl" type="url" placeholder="https://cloudhubs.example.com" />
                    <span class="form-text">Use the externally reachable HTTP or HTTPS address, if configured.</span>
                    <span class="text-danger" asp-validation-for="PublicUrl"></span>
                </div>
                break;
            case "security":
                <p class="settings-section-description">Limits applied to Superadmin browser sessions and API tokens.</p>
                <div class="mb-3">
                    <label class="form-label" asp-for="SessionTimeoutMinutes">Superadmin session lifetime (minutes)</label>
                    <input class="form-control" asp-for="SessionTimeoutMinutes" type="number" min="15" max="720" required />
                    <span class="text-danger" asp-validation-for="SessionTimeoutMinutes"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="JwtLifetimeMinutes">API access-token lifetime (minutes)</label>
                    <input class="form-control" asp-for="JwtLifetimeMinutes" type="number" min="5" max="60" required />
                    <span class="text-danger" asp-validation-for="JwtLifetimeMinutes"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="MinimumPasswordLength">Minimum password length</label>
                    <input class="form-control" asp-for="MinimumPasswordLength" type="number" min="8" max="128" required />
                    <span class="text-danger" asp-validation-for="MinimumPasswordLength"></span>
                </div>
                <div class="form-check">
                    <input class="form-check-input" asp-for="RequirePasswordDigit" />
                    <label class="form-check-label" asp-for="RequirePasswordDigit">Require at least one digit in passwords</label>
                </div>
                <div class="alert alert-info mt-3 mb-0" role="note">Password rules apply when creating or changing platform user passwords, including the bootstrapped Superadmin password. MFA is not yet supported.</div>
                <a class="btn btn-outline-secondary mt-3" href="/su/settings/security/account">Change Superadmin email or password</a>
                break;
            case "organizations":
                <p class="settings-section-description">Defaults applied when a new organization is created.</p>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="AllowOrganizationCreation" />
                    <label class="form-check-label" asp-for="AllowOrganizationCreation">Allow Superadmin to create organizations</label>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="DefaultOrganizationStatus">Default organization status</label>
                    <select class="form-select" asp-for="DefaultOrganizationStatus">
                        <option value="Draft">Draft</option>
                        <option value="Active">Active</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Archived">Archived</option>
                    </select>
                    <span class="text-danger" asp-validation-for="DefaultOrganizationStatus"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="DefaultTrialDays">Default trial duration (days)</label>
                    <input class="form-control" asp-for="DefaultTrialDays" type="number" min="0" max="365" required />
                    <span class="text-danger" asp-validation-for="DefaultTrialDays"></span>
                </div>
                break;
            case "catalog":
                <p class="settings-section-description">Default for newly created platform-owned projects.</p>
                <div>
                    <label class="form-label" asp-for="DefaultTemplateId">Default template ID</label>
                    <input class="form-control" asp-for="DefaultTemplateId" required />
                    <span class="text-danger" asp-validation-for="DefaultTemplateId"></span>
                </div>
                break;
            case "billing":
                <p class="settings-section-description">Plan details copied onto new organization subscriptions.</p>
                <div class="alert alert-info" role="note">These values are stored with new subscriptions. Payment processing and invoicing are not integrated yet.</div>
                <div class="mb-3">
                    <label class="form-label" asp-for="DefaultPlanName">Default plan name</label>
                    <input class="form-control" asp-for="DefaultPlanName" required />
                    <span class="text-danger" asp-validation-for="DefaultPlanName"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="BillingCurrency">Billing currency</label>
                    <input class="form-control" asp-for="BillingCurrency" maxlength="3" autocapitalize="characters" placeholder="USD" required />
                    <span class="text-danger" asp-validation-for="BillingCurrency"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="MonthlyPrice">Monthly price</label>
                    <input class="form-control" asp-for="MonthlyPrice" type="number" min="0" max="9999999999" step="0.01" required />
                    <span class="text-danger" asp-validation-for="MonthlyPrice"></span>
                </div>
                break;
            case "notifications":
                <p class="settings-section-description">Email alerts for newly created organizations, sent through the configured SMTP server.</p>
                <div class="alert alert-info" role="note">Configure EMAIL__SMTP__HOST. Port defaults to 587, TLS defaults to enabled, and sender address defaults to the platform support email. Optional credentials use EMAIL__SMTP__USERNAME and EMAIL__SMTP__PASSWORD; configure EMAIL__SMTP__FROMADDRESS to override the sender.</div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="NotifyOnOrganizationCreated" />
                    <label class="form-check-label" asp-for="NotifyOnOrganizationCreated">Notify when an organization is created</label>
                </div>
                <div>
                    <label class="form-label" asp-for="NotificationEmail">Notification recipient</label>
                    <input class="form-control" asp-for="NotificationEmail" type="email" autocomplete="email" />
                    <span class="text-danger" asp-validation-for="NotificationEmail"></span>
                </div>
                break;
        }

        <div class="form-actions mt-4">
            <a class="btn btn-outline-secondary" href="/su/settings">Cancel</a>
            <button class="btn btn-success" type="submit">Save changes</button>
        </div>
    </form>
}
