@model IReadOnlyCollection<CloudHubs.Domain.Subscriptions.SubscriptionPurchase>
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    ViewData["Title"] = "Subscription purchase requests";
    ViewData["Section"] = "Purchases";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">CONTROL PLANE / BILLING</p>
        <h1>Purchase requests</h1>
        <p>Verify manual payment before approving account creation.</p>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (TempData["SignupLink"] is string signupLink)
{
    <div class="alert alert-warning" role="alert">
        <label class="form-label" for="signup-link">One-time signup link (copy and send to the customer):</label>
        <input id="signup-link" class="form-control" value="@signupLink" readonly />
    </div>
}

<section class="surface">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><strong>No purchase requests</strong><span>Manual payment requests will appear here.</span></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Customer</th><th>Plan</th><th>Amount</th><th>Status</th><th>Requested</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var purchase in Model)
                    {
                        <tr>
                            <td><strong>@purchase.Name</strong><small class="d-block org-email">@purchase.Email</small><small class="d-block org-email">@purchase.Id</small></td>
                            <td>@purchase.PlanName</td>
                            <td>@purchase.Currency @purchase.Price.ToString("0.00") / @purchase.BillingInterval</td>
                            <td>@purchase.Status</td>
                            <td>@purchase.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</td>
                            <td>
                                @if (purchase.Status == CloudHubs.Domain.Subscriptions.SubscriptionPurchaseStatus.PendingPayment)
                                {
                                    <div class="table-actions">
                                        <form method="post" action="/su/purchases/@purchase.Id/approve" onsubmit="return confirm('Confirm that payment was received and approve account setup?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-success" type="submit">Approve payment</button>
                                        </form>
                                        <form method="post" action="/su/purchases/@purchase.Id/reject" onsubmit="return confirm('Reject this purchase request?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Reject</button>
                                        </form>
                                    </div>
                                }
                                else if (purchase.Status == CloudHubs.Domain.Subscriptions.SubscriptionPurchaseStatus.PaymentApproved)
                                {
                                    <form method="post" action="/su/purchases/@purchase.Id/reissue-link">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">Generate new signup link</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
