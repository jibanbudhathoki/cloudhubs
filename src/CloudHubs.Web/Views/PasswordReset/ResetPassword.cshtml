@model CloudHubs.Web.ViewModels.Auth.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Reset Password";
    var errors = ViewData.ModelState.Values
        .SelectMany(state => state.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToArray();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password - CloudHubs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
</head>
<body class="login-page">
    <main class="login-shell">
        <a class="brand" href="/login">
            <span class="brand-mark">C</span>
            <span><strong>CloudHubs</strong><small>ACCOUNT RECOVERY</small></span>
        </a>
        <section class="login-panel">
            <p class="eyebrow">SECURITY</p>
            <h1>Reset Password</h1>

            @if (!Model.IsValidToken)
            {
                <div class="alert alert-danger mt-3" role="alert">
                    <strong>Link Expired or Invalid</strong>
                    <p class="mb-0 mt-1 small">@(Model.ErrorMessage ?? "This password reset link is invalid or has expired.")</p>
                </div>
                <div class="mt-4 d-grid gap-2">
                    <a href="/forgot-password" class="btn btn-success">Request a New Link</a>
                    <a href="/login" class="btn btn-outline-secondary">Return to Sign In</a>
                </div>
            }
            else
            {
                <p>Choose a secure new password for <strong>@Model.Email</strong>.</p>

                @if (errors.Length > 0)
                {
                    <div class="alert alert-danger" role="alert" aria-live="assertive">
                        <ul class="mb-0">
                            @foreach (var error in errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" action="/reset-password" class="login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />

                    <label asp-for="Password">New Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" required autofocus />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <small class="text-muted" style="font-size: 11px;">Must be at least 8 characters and contain at least one digit.</small>

                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>

                    <button class="btn btn-success w-100 mt-3" type="submit">Update Password</button>
                </form>

                <div class="text-center mt-3">
                    <a href="/login" class="login-back">← Cancel and Back to Sign In</a>
                </div>
            }
        </section>
        <span class="login-back">Your new password will be active immediately after saving.</span>
    </main>
</body>
</html>

