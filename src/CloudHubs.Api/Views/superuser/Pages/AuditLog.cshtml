@model AuditLogIndexViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    ViewData["Title"] = "Audit log";
    ViewData["Section"] = "Audit";
    var pageCount = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / 50d));
}

<section class="page-heading">
    <div><p class="eyebrow">CONTROL PLANE / SECURITY</p><h1>Audit log</h1><p>Superadmin write actions with actor, target, time, and response status.</p></div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning" role="alert">@Model.ErrorMessage</div>
}

<section class="surface">
    <form class="row g-3 p-3 border-bottom" method="get" action="/su/audit">
        <div class="col-lg-4"><label class="form-label" for="query">Search</label><input class="form-control" id="query" name="query" value="@Model.Query" maxlength="200" placeholder="Actor, action, resource ID" /></div>
        <div class="col-lg-3">
            <label class="form-label" for="organizationId">Organization</label>
            <select class="form-select" id="organizationId" name="organizationId">
                <option value="">All organizations</option>
                @foreach (var organization in Model.Organizations)
                {
                    <option value="@organization.Id" selected="@(Model.OrganizationId == organization.Id ? "selected" : null)">@organization.Name</option>
                }
            </select>
        </div>
        <div class="col-lg-2"><label class="form-label" for="from">From</label><input class="form-control" id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-lg-2"><label class="form-label" for="to">To</label><input class="form-control" id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-lg-1 d-flex align-items-end"><button class="btn btn-success w-100" type="submit">Filter</button></div>
    </form>
    <div class="surface-heading"><div><h2>Events</h2><p>@Model.TotalCount matching event(s), showing up to 50 per page.</p></div><span class="count">@Model.Page / @pageCount</span></div>
    @if (Model.Entries.Count == 0)
    {
        <div class="empty-state"><strong>No audit events found</strong><span>Superadmin write actions will appear here after they are recorded.</span></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Resource</th><th>Details</th></tr></thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><strong>@entry.ActorName</strong><small class="d-block org-email">@entry.ActorId</small></td>
                            <td>@entry.Action</td>
                            <td>@entry.ResourceType @entry.ResourceId</td>
                            <td>@entry.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <nav class="p-3" aria-label="Audit log pages">
        <div class="d-flex justify-content-between">
            @if (Model.Page > 1)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", new { query = Model.Query, organizationId = Model.OrganizationId, from = Model.From?.ToString("yyyy-MM-dd"), to = Model.To?.ToString("yyyy-MM-dd"), page = Model.Page - 1 })">Previous</a>
            }
            else
            {
                <span></span>
            }
            @if (Model.Page < pageCount)
            {
                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", new { query = Model.Query, organizationId = Model.OrganizationId, from = Model.From?.ToString("yyyy-MM-dd"), to = Model.To?.ToString("yyyy-MM-dd"), page = Model.Page + 1 })">Next</a>
            }
        </div>
    </nav>
</section>
