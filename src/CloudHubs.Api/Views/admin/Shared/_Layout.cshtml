<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CloudHubs Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar">
            @await Html.PartialAsync("~/Views/admin/Components/_Sidebar.cshtml")
        </aside>
        <main class="admin-main">
            <header class="topbar">
                <div class="breadcrumbs">CloudHubs <span>/</span> <strong>Admin</strong></div>
                <a class="text-link" href="/super-admin/">Switch to Superuser</a>
            </header>
            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>