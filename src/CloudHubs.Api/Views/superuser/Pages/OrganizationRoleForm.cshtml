@model OrganizationRoleFormViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit organization role" : "Create organization role";
    ViewData["Section"] = "Organizations";
}

<section class="page-heading">
    <div><p class="eyebrow">CONTROL PLANE / ORGANIZATIONS</p><h1>@ViewData["Title"]</h1><p>Choose the organization permissions this role grants.</p></div>
    <a class="btn btn-outline-secondary" href="/su/organization/@Model.OrganizationId/roles">Back to roles</a>
</section>

<form class="surface admin-form" method="post" action="@(isEdit ? $"/su/organization/{Model.OrganizationId}/roles/{Model.Id}/edit" : $"/su/organization/{Model.OrganizationId}/roles/create")">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="All" role="alert"></div>
    }
    <div class="mb-3"><label class="form-label" asp-for="Name">Role name</label><input class="form-control" asp-for="Name" required /><span class="text-danger" asp-validation-for="Name"></span></div>
    <div class="mb-4"><label class="form-label" asp-for="Description">Description</label><textarea class="form-control" asp-for="Description" rows="2"></textarea><span class="text-danger" asp-validation-for="Description"></span></div>
    <fieldset class="mb-4">
        <legend>Permissions</legend>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ViewProjects" /><label class="form-check-label" asp-for="ViewProjects">View projects</label></div>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ManageProjects" /><label class="form-check-label" asp-for="ManageProjects">Create and manage projects</label></div>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ViewMembers" /><label class="form-check-label" asp-for="ViewMembers">View members</label></div>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ManageMembers" /><label class="form-check-label" asp-for="ManageMembers">Invite and manage members</label></div>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ManageSettings" /><label class="form-check-label" asp-for="ManageSettings">Manage organization settings</label></div>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ManageIntegrations" /><label class="form-check-label" asp-for="ManageIntegrations">Manage integrations</label></div>
        <div class="form-check mb-2"><input class="form-check-input" asp-for="ViewAuditLog" /><label class="form-check-label" asp-for="ViewAuditLog">View audit log</label></div>
        <div class="form-check"><input class="form-check-input" asp-for="ManageBilling" /><label class="form-check-label" asp-for="ManageBilling">Manage billing</label></div>
    </fieldset>
    <div class="form-actions"><a class="btn btn-outline-secondary" href="/su/organization/@Model.OrganizationId/roles">Cancel</a><button class="btn btn-success" type="submit">@(isEdit ? "Save changes" : "Create role")</button></div>
</form>
