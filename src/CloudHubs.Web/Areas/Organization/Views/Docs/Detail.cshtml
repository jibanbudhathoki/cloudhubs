@model CloudHubs.Web.ViewModels.Docs.OrganizationDocsViewModel
@{
    Layout = null;
    var currentOrganization = Model.CurrentOrganization!;
    var selected = Model.SelectedDoc!;
    ViewData["Title"] = $"{selected.Title} - API Docs";
    var hasApiKey = !string.IsNullOrWhiteSpace(selected.ApiKey);
    var hasTestApiKey = !string.IsNullOrWhiteSpace(selected.TestApiKey);
    var hasSecretKey = !string.IsNullOrWhiteSpace(selected.SecretKey);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@selected.Title - API Docs - CloudHubs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
    <style>
        .doc-badge-pill {
            font-size: 11px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: 4px;
            background: #eaf0eb;
            color: #3b5a45;
            display: inline-block;
        }
        .doc-badge-api { background: #e0f2fe; color: #0369a1; }
        .doc-badge-project { background: #dcfce7; color: #15803d; }
        .doc-badge-mobile { background: #f3e8ff; color: #7e22ce; }

        .auth-pill {
            font-size: 11.5px;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }
        .auth-pill-key { background: #fef3c7; color: #92400e; }
        .auth-pill-none { background: #f1f5f9; color: #475569; }

        /* Detail section styling */
        .cred-strip {
            background: #f8fafc;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 16px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 16px;
            margin-bottom: 20px;
        }
        .cred-label {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }
        .docs-markdown {
            color: #1e293b;
            font-size: 13.5px;
            line-height: 1.7;
        }
        .docs-markdown h1 {
            font-size: 19px;
            font-weight: 700;
            color: #0f172a;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 6px;
            margin-top: 10px;
            margin-bottom: 12px;
        }
        .docs-markdown h2 {
            font-size: 15.5px;
            font-weight: 700;
            color: #0f172a;
            margin-top: 18px;
            margin-bottom: 8px;
        }
        .docs-markdown h3 {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
            margin-top: 14px;
            margin-bottom: 6px;
        }
        .docs-markdown pre {
            background: #0f172a;
            color: #f8fafc;
            border-radius: 6px;
            padding: 12px 14px;
            overflow-x: auto;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12px;
            line-height: 1.5;
            margin: 12px 0;
        }
        .docs-markdown code {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            background: #f1f5f9;
            color: #0f172a;
            padding: 2px 5px;
            border-radius: 3px;
            font-size: 12px;
        }
        .docs-markdown pre code {
            background: transparent;
            color: #e2e8f0;
            padding: 0;
        }
        .code-box {
            background: #0f172a;
            color: #e2e8f0;
            padding: 14px;
            border-radius: 6px;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 12px;
            line-height: 1.5;
            overflow-x: auto;
        }
        .postman-req-badge {
            font-size: 10px;
            font-weight: 700;
            padding: 3px 6px;
            border-radius: 4px;
            min-width: 50px;
            display: inline-block;
            text-align: center;
        }
        .badge-get { background: #dbeafe; color: #1e40af; }
        .badge-post { background: #dcfce7; color: #15803d; }
        .badge-put { background: #fef3c7; color: #b45309; }
        .badge-delete { background: #fee2e2; color: #b91c1c; }
        .badge-patch { background: #f3e8ff; color: #7e22ce; }

        .env-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .env-table th {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            padding: 8px 12px;
            border-bottom: 1px solid var(--line);
            background: #f8fafc;
            text-transform: uppercase;
        }
        .env-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--line);
            font-size: 12px;
            vertical-align: middle;
        }
        .env-val.masked {
            font-family: text-security-disc, -webkit-small-control, monospace;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="admin-shell">
        <aside class="admin-sidebar organization-sidebar">
            <a class="brand" href="/organization">
                <span class="brand-mark">C</span>
                <span><strong>CloudHubs</strong><small>ORGANIZATION</small></span>
            </a>
            <p class="role-label">CURRENT ORGANIZATION</p>
            @if (Model.Organizations.Count > 1 || Model.CanShowOrganizationAction)
            {
                <details class="workspace-top-dropdown">
                    <summary class="role-switch workspace-top-trigger" title="Click to switch workspace">
                        <span class="tenant-mark">@currentOrganization.Name[..Math.Min(currentOrganization.Name.Length, 2)].ToUpperInvariant()</span>
                        <span class="workspace-meta">
                            <strong>@currentOrganization.Name</strong>
                            <small>@currentOrganization.Role</small>
                        </span>
                        <span class="workspace-switch-badge">Switch ▾</span>
                    </summary>
                    <div class="workspace-top-menu">
                        <div class="workspace-menu-label">CURRENT WORKSPACE</div>
                        <div class="workspace-menu-item current">
                            <span class="tenant-mark-sm">@currentOrganization.Name[..Math.Min(currentOrganization.Name.Length, 2)].ToUpperInvariant()</span>
                            <span class="workspace-menu-name">@currentOrganization.Name</span>
                            <span class="workspace-check">✓</span>
                        </div>
                        @if (Model.Organizations.Count > 1)
                        {
                            <div class="workspace-menu-divider"></div>
                            <div class="workspace-menu-label">SWITCH WORKSPACE</div>
                            @foreach (var org in Model.Organizations.Where(item => item.Id != currentOrganization.Id))
                            {
                                <form method="post" action="/organization/select" class="workspace-menu-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="organizationId" value="@org.Id" />
                                    <button class="workspace-menu-item" type="submit">
                                        <span class="tenant-mark-sm">@org.Name[..Math.Min(org.Name.Length, 2)].ToUpperInvariant()</span>
                                        <span class="workspace-menu-name">@org.Name</span>
                                    </button>
                                </form>
                            }
                        }
                        <div class="workspace-menu-divider"></div>
                        @if (Model.CanShowOrganizationAction)
                        {
                            <a class="workspace-menu-item action-link" href="/organization/create">
                                <span class="workspace-action-icon">+</span>
                                <span>Add organization</span>
                            </a>
                        }
                        <form method="post" action="/organization/workspaces" class="workspace-menu-form">
                            @Html.AntiForgeryToken()
                            <button class="workspace-menu-item action-link" type="submit">
                                <span class="workspace-action-icon">⊞</span>
                                <span>View all workspaces</span>
                            </button>
                        </form>
                    </div>
                </details>
            }
            else
            {
                <div class="role-switch">
                    <span class="tenant-mark">@currentOrganization.Name[..Math.Min(currentOrganization.Name.Length, 2)].ToUpperInvariant()</span>
                    <span><strong>@currentOrganization.Name</strong><small>@currentOrganization.Role</small></span>
                </div>
            }
            <nav class="side-nav" aria-label="Workspace sections">
                <a class="side-link" href="/organization">Overview</a>
                <a class="side-link" href="/organization/projects">Projects</a>
                <a class="side-link" href="/organization/merospace">MeroSpace</a>
                <a class="side-link active" href="/organization/docs" aria-current="page">Docs</a>
                @if (Model.CanViewMembers)
                {
                    <a class="side-link" href="/organization/members">Members</a>
                }
                <a class="side-link" href="/organization/settings">Settings</a>
            </nav>
            <div class="sidebar-spacer"></div>
            <div class="organization-sidebar-account">
                <span class="avatar">@((Model.UserName.Length > 0 ? Model.UserName[..1] : "U").ToUpperInvariant())</span>
                <span><strong>@Model.UserName</strong><small>@Model.UserEmail</small></span>
            </div>
        </aside>

        <main class="admin-main" id="main-content" tabindex="-1">
            <header class="topbar">
                <div class="breadcrumbs">
                    <a href="/organization">Workspace</a>
                    <span>/</span>
                    <a href="/organization">@currentOrganization.Name</a>
                    <span>/</span>
                    <a href="/organization/docs">Docs</a>
                    <span>/</span>
                    <strong>@selected.Title</strong>
                </div>
                <div class="heading-actions">
                    <a class="btn btn-outline-secondary btn-sm" href="/organization/docs">← Back to Docs</a>
                    @if (Model.CanManageDocs)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="/organization/docs/@selected.Id/edit">✏️ Edit</a>
                    }
                    <a class="btn btn-primary btn-sm" href="/organization/merospace">Launch MeroSpace</a>
                </div>
            </header>

            <div class="page-content organization-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success" role="status">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <!-- Dedicated Documentation View Surface Card -->
                <section class="surface organization-section">
                    <div class="surface-heading d-flex align-items-start justify-content-between flex-wrap gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="doc-badge-pill @(selected.Category.ToLowerInvariant().Contains("api") ? "doc-badge-api" : "doc-badge-pill")">@selected.Category</span>
                                @if (selected.ProjectId.HasValue)
                                {
                                    var prj = Model.Projects.FirstOrDefault(p => p.Id == selected.ProjectId.Value);
                                    if (prj is not null)
                                    {
                                        <span class="badge bg-light text-secondary border">📁 Project: @prj.Name</span>
                                    }
                                }
                                @if (!selected.IsPublicToMembers)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" title="Only selected members can access this documentation">
                                        🔒 Specific Members Only (@selected.AllowedMembers.Count)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">
                                        🌐 All Members
                                    </span>
                                }
                            </div>
                            <h1 class="h4 mb-1 fw-bold text-dark">@selected.Title</h1>
                            <p class="text-secondary small mb-0">@(string.IsNullOrWhiteSpace(selected.Description) ? "API documentation and integration configuration." : selected.Description)</p>
                        </div>
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <a class="btn btn-primary btn-sm" href="/organization/docs/@selected.Id/download-bundle">
                                📦 Download Developer Kit (.zip)
                            </a>
                            <a class="btn btn-outline-secondary btn-sm" href="/organization/docs/@selected.Id/download-docs">
                                ⬇ Markdown (.md)
                            </a>
                            @if (!string.IsNullOrWhiteSpace(selected.PostmanCollection))
                            {
                                <a class="btn btn-outline-secondary btn-sm" href="/organization/docs/@selected.Id/download-postman">
                                    Postman (.json)
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(selected.EnvironmentVariables))
                            {
                                <a class="btn btn-outline-secondary btn-sm" href="/organization/docs/@selected.Id/download-env">
                                    .env
                                </a>
                            }
                            @if (Model.CanManageDocs)
                            {
                                <a class="btn btn-outline-primary btn-sm" href="/organization/docs/@selected.Id/edit">
                                    ✏️ Edit
                                </a>
                                <form method="post" action="/organization/docs/@selected.Id/delete" onsubmit="return confirm('Delete this documentation profile?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            }
                        </div>
                    </div>

                    <!-- Credentials & Integration Strip -->
                    <div class="cred-strip mt-3">
                        <div>
                            <div class="cred-label">API BASE URL</div>
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control font-monospace" id="doc-base-url" value="@(string.IsNullOrWhiteSpace(selected.BaseUrl) ? "https://api.cloudhubs.com/v1" : selected.BaseUrl)" readonly />
                                <button class="btn btn-outline-secondary" type="button" onclick="copyText('doc-base-url', this)">Copy</button>
                            </div>
                        </div>
                        @if (hasApiKey)
                        {
                            <div>
                                <div class="cred-label d-flex align-items-center justify-content-between">
                                    <span>LIVE API KEY (PRODUCTION)</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 10px;">Live</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="password" class="form-control font-monospace" id="doc-api-key" value="@selected.ApiKey" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('doc-api-key', this)">👁</button>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyPassword('doc-api-key', this)">Copy</button>
                                </div>
                            </div>
                        }
                        @if (hasTestApiKey)
                        {
                            <div>
                                <div class="cred-label d-flex align-items-center justify-content-between">
                                    <span>TEST / DEMO API KEY (SANDBOX)</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 10px;">Test / Demo</span>
                                </div>
                                <div class="input-group input-group-sm">
                                    <input type="password" class="form-control font-monospace" id="doc-test-api-key" value="@selected.TestApiKey" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('doc-test-api-key', this)">👁</button>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyPassword('doc-test-api-key', this)">Copy</button>
                                </div>
                            </div>
                        }
                        @if (!hasApiKey && !hasTestApiKey)
                        {
                            <div>
                                <div class="cred-label">AUTHENTICATION</div>
                                <div class="p-1 px-2 border rounded bg-white text-muted small d-flex align-items-center gap-2" style="height: 31px;">
                                    <span>🔓</span> <strong>No API Key Required</strong> (Public / Custom Auth)
                                </div>
                            </div>
                        }
                        @if (hasSecretKey)
                        {
                            <div>
                                <div class="cred-label">SECRET KEY / WEBHOOK</div>
                                <div class="input-group input-group-sm">
                                    <input type="password" class="form-control font-monospace" id="doc-secret-key" value="@selected.SecretKey" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('doc-secret-key', this)">👁</button>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyPassword('doc-secret-key', this)">Copy</button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Tabs: Documentation, Postman, Environment, Snippets -->
                    <ul class="nav nav-tabs mb-3" id="docDetailTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-doc-content" data-bs-toggle="tab" data-bs-target="#pane-doc-content" type="button" role="tab">
                                📖 API Documentation
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-doc-postman" data-bs-toggle="tab" data-bs-target="#pane-doc-postman" type="button" role="tab">
                                🚀 Postman Collection
                                @if (!string.IsNullOrWhiteSpace(selected.PostmanCollection))
                                {
                                    <span class="badge bg-light text-secondary border ms-1" id="postman-count-pill">JSON</span>
                                }
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-doc-env" data-bs-toggle="tab" data-bs-target="#pane-doc-env" type="button" role="tab">
                                🔐 Environment Variables (.env)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-doc-code" data-bs-toggle="tab" data-bs-target="#pane-doc-code" type="button" role="tab">
                                💻 Code Snippets
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Panes -->
                    <div class="tab-content" id="docDetailTabContent">
                        <!-- TAB 1: Markdown -->
                        <div class="tab-pane fade show active" id="pane-doc-content" role="tabpanel">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-muted small">Markdown documentation &amp; endpoint references.</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyMarkdownContent(this)">📋 Copy Markdown</button>
                            </div>
                            <div class="p-3 bg-white rounded border docs-markdown">
                                @if (string.IsNullOrWhiteSpace(selected.Content))
                                {
                                    <div class="text-center py-4 text-muted">
                                        <p class="mb-1">No API documentation written yet.</p>
                                        <small>Click "Edit" above to add Markdown documentation and endpoints.</small>
                                    </div>
                                }
                                else
                                {
                                    <div id="rendered-markdown-text"></div>
                                }
                            </div>
                            <textarea id="raw-markdown-source" style="display: none;">@selected.Content</textarea>
                        </div>

                        <!-- TAB 2: Postman -->
                        <div class="tab-pane fade" id="pane-doc-postman" role="tabpanel">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <span class="text-muted small">Postman &amp; Bruno compatible collection.</span>
                                @if (!string.IsNullOrWhiteSpace(selected.PostmanCollection))
                                {
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-success btn-sm" href="/organization/docs/@selected.Id/download-postman">⬇ Download JSON</a>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyPostmanJson(this)">📋 Copy JSON</button>
                                    </div>
                                }
                            </div>

                            @if (string.IsNullOrWhiteSpace(selected.PostmanCollection))
                            {
                                <div class="text-center py-4 bg-light rounded border text-muted">
                                    <p class="mb-1">No Postman collection JSON added yet.</p>
                                    <small>Click "Edit" above to upload or paste your Postman / Bruno collection.</small>
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <h6 class="fw-bold small text-muted text-uppercase mb-2">Detected Endpoints</h6>
                                    <div id="doc-postman-endpoints" class="list-group mb-3"></div>
                                </div>
                                <details>
                                    <summary class="btn btn-outline-secondary btn-sm">Show Raw Collection JSON</summary>
                                    <pre class="code-box mt-2" id="doc-postman-raw">@selected.PostmanCollection</pre>
                                </details>
                            }
                        </div>

                        <!-- TAB 3: Environment Variables -->
                        <div class="tab-pane fade" id="pane-doc-env" role="tabpanel">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <span class="text-muted small">Environment variables template for local and server deployment.</span>
                                @if (!string.IsNullOrWhiteSpace(selected.EnvironmentVariables))
                                {
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-success btn-sm" href="/organization/docs/@selected.Id/download-env">⬇ Download .env</a>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyEnvText(this)">📋 Copy .env</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleDocEnvMasking(this)" id="doc-mask-btn">👁 Toggle Secrets</button>
                                    </div>
                                }
                            </div>

                            @if (string.IsNullOrWhiteSpace(selected.EnvironmentVariables))
                            {
                                <div class="text-center py-4 bg-light rounded border text-muted">
                                    <p class="mb-1">No environment variables defined yet.</p>
                                    <small>Click "Edit" above to configure environment variables for this API.</small>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive border rounded mb-3 bg-white">
                                    <table class="env-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 35%;">VARIABLE</th>
                                                <th>VALUE</th>
                                                <th style="width: 80px; text-align: right;">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody id="doc-env-table-body"></tbody>
                                    </table>
                                </div>
                                <details>
                                    <summary class="btn btn-outline-secondary btn-sm">Show Raw .env Text</summary>
                                    <pre class="code-box mt-2" id="doc-env-raw">@selected.EnvironmentVariables</pre>
                                </details>
                            }
                        </div>

                        <!-- TAB 4: Code Snippets -->
                        <div class="tab-pane fade" id="pane-doc-code" role="tabpanel">
                            @{
                                var effectiveSnippetKey = !string.IsNullOrWhiteSpace(selected.ApiKey) ? selected.ApiKey : selected.TestApiKey;
                                var effectiveBaseUrl = string.IsNullOrWhiteSpace(selected.BaseUrl) ? "https://api.cloudhubs.com/v1" : selected.BaseUrl;
                            }
                            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                                <span class="text-muted small">Pre-configured code integration snippets for your services.</span>
                                @if (hasApiKey && hasTestApiKey)
                                {
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-success active" id="btn-env-live" onclick="switchSnippetEnv('live')">Production (Live)</button>
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark" id="btn-env-test" onclick="switchSnippetEnv('test')">Sandbox (Test / Demo)</button>
                                    </div>
                                }
                                else if (hasTestApiKey)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Using Test / Demo Key</span>
                                }
                                else if (hasApiKey)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Using Live Key</span>
                                }
                            </div>

                            <!-- cURL -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-muted">cURL</strong>
                                    <button class="btn btn-outline-secondary btn-sm py-0" onclick="copySnippet('snippet-curl', this)">Copy</button>
                                </div>
                                <pre class="code-box" id="snippet-curl">curl -X GET "@effectiveBaseUrl" \
  -H "Accept: application/json"@(!string.IsNullOrWhiteSpace(effectiveSnippetKey) ? $" \\\n  -H \"Authorization: Bearer {effectiveSnippetKey}\"" : "")</pre>
                            </div>

                            <!-- JavaScript / Fetch -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-muted">JavaScript (fetch)</strong>
                                    <button class="btn btn-outline-secondary btn-sm py-0" onclick="copySnippet('snippet-js', this)">Copy</button>
                                </div>
                                <pre class="code-box" id="snippet-js">const response = await fetch("@effectiveBaseUrl", {
  headers: {
    "Accept": "application/json"@(!string.IsNullOrWhiteSpace(effectiveSnippetKey) ? $",\n    \"Authorization\": \"Bearer {effectiveSnippetKey}\"" : "")
  }
});
const data = await response.json();
console.log(data);</pre>
                            </div>

                            <!-- Python -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-muted">Python (requests)</strong>
                                    <button class="btn btn-outline-secondary btn-sm py-0" onclick="copySnippet('snippet-python', this)">Copy</button>
                                </div>
                                <pre class="code-box" id="snippet-python">import requests

url = "@effectiveBaseUrl"
headers = {
    "Accept": "application/json"@(!string.IsNullOrWhiteSpace(effectiveSnippetKey) ? $",\n    \"Authorization\": \"Bearer {effectiveSnippetKey}\"" : "")
}

response = requests.get(url, headers=headers)
print(response.json())</pre>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/portal.js"></script>
    <script>
        var docLiveKey = '@Html.Raw(selected.ApiKey ?? "")';
        var docTestKey = '@Html.Raw(selected.TestApiKey ?? "")';
        var docBaseUrl = '@Html.Raw(string.IsNullOrWhiteSpace(selected.BaseUrl) ? "https://api.cloudhubs.com/v1" : selected.BaseUrl)';

        function switchSnippetEnv(env) {
            var isLive = env === 'live';
            var key = isLive ? docLiveKey : docTestKey;
            var btnLive = document.getElementById('btn-env-live');
            var btnTest = document.getElementById('btn-env-test');
            if (btnLive && btnTest) {
                if (isLive) {
                    btnLive.classList.add('active');
                    btnTest.classList.remove('active');
                } else {
                    btnTest.classList.add('active');
                    btnLive.classList.remove('active');
                }
            }

            var curlPre = document.getElementById('snippet-curl');
            if (curlPre) {
                curlPre.innerText = 'curl -X GET "' + docBaseUrl + '" \\\n  -H "Accept: application/json"' +
                    (key ? ' \\\n  -H "Authorization: Bearer ' + key + '"' : '');
            }

            var jsPre = document.getElementById('snippet-js');
            if (jsPre) {
                jsPre.innerText = 'const response = await fetch("' + docBaseUrl + '", {\n  headers: {\n    "Accept": "application/json"' +
                    (key ? ',\n    "Authorization": "Bearer ' + key + '"' : '') + '\n  }\n});\nconst data = await response.json();\nconsole.log(data);';
            }

            var pyPre = document.getElementById('snippet-python');
            if (pyPre) {
                pyPre.innerText = 'import requests\n\nurl = "' + docBaseUrl + '"\nheaders = {\n    "Accept": "application/json"' +
                    (key ? ',\n    "Authorization": "Bearer ' + key + '"' : '') + '\n}\n\nresponse = requests.get(url, headers=headers)\nprint(response.json())';
            }
        }

        // Copy text helper
        function copyText(id, btn) {
            var el = document.getElementById(id);
            if (el && el.value) {
                navigator.clipboard.writeText(el.value).then(function() {
                    var orig = btn.innerText; btn.innerText = '✓'; setTimeout(() => btn.innerText = orig, 1200);
                });
            }
        }

        function copyPassword(id, btn) {
            var el = document.getElementById(id);
            if (el && el.value) {
                navigator.clipboard.writeText(el.value).then(function() {
                    var orig = btn.innerText; btn.innerText = '✓'; setTimeout(() => btn.innerText = orig, 1200);
                });
            }
        }

        function togglePasswordVisibility(id, btn) {
            var el = document.getElementById(id);
            if (el) {
                if (el.type === 'password') {
                    el.type = 'text';
                    btn.innerText = '🙈';
                } else {
                    el.type = 'password';
                    btn.innerText = '👁';
                }
            }
        }

        function copySnippet(id, btn) {
            var el = document.getElementById(id);
            if (el) {
                navigator.clipboard.writeText(el.innerText).then(function() {
                    var orig = btn.innerText; btn.innerText = '✓ Copied!'; setTimeout(() => btn.innerText = orig, 1200);
                });
            }
        }

        function copyMarkdownContent(btn) {
            var val = document.getElementById('raw-markdown-source')?.value;
            if (val) {
                navigator.clipboard.writeText(val).then(function() {
                    var orig = btn.innerText; btn.innerText = '✓ Copied!'; setTimeout(() => btn.innerText = orig, 1200);
                });
            }
        }

        function copyPostmanJson(btn) {
            var val = document.getElementById('doc-postman-raw')?.innerText;
            if (val) {
                navigator.clipboard.writeText(val).then(function() {
                    var orig = btn.innerText; btn.innerText = '✓ Copied!'; setTimeout(() => btn.innerText = orig, 1200);
                });
            }
        }

        function copyEnvText(btn) {
            var val = document.getElementById('doc-env-raw')?.innerText;
            if (val) {
                navigator.clipboard.writeText(val).then(function() {
                    var orig = btn.innerText; btn.innerText = '✓ Copied!'; setTimeout(() => btn.innerText = orig, 1200);
                });
            }
        }

        // Markdown renderer
        function renderMarkdown(md) {
            if (!md) return '';
            return md
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/^### (.*$)/gim, '<h3>$1</h3>')
                .replace(/^## (.*$)/gim, '<h2>$1</h2>')
                .replace(/^# (.*$)/gim, '<h1>$1</h1>')
                .replace(/```([a-z]*)\n([\s\S]*?)```/gim, '<pre><code>$2</code></pre>')
                .replace(/`([^`]+)`/gim, '<code>$1</code>')
                .replace(/\*\*([^*]+)\*\*/gim, '<strong>$1</strong>')
                .replace(/\*([^*]+)\*/gim, '<em>$1</em>')
                .replace(/^\- (.*$)/gim, '<li>$1</li>')
                .replace(/\n\n/gim, '<p></p>');
        }

        var mdSource = document.getElementById('raw-markdown-source')?.value || '';
        var renderEl = document.getElementById('rendered-markdown-text');
        if (renderEl && mdSource) {
            var trimmed = mdSource.trim();
            if (trimmed.startsWith('<') && (trimmed.endsWith('>') || trimmed.includes('</'))) {
                renderEl.innerHTML = mdSource;
            } else {
                renderEl.innerHTML = renderMarkdown(mdSource);
            }
        }

        // Parse Postman Collection requests
        function parsePostmanRequests() {
            var listEl = document.getElementById('doc-postman-endpoints');
            if (!listEl) return;
            var jsonText = document.getElementById('doc-postman-raw')?.innerText;
            if (!jsonText) return;
            try {
                var col = JSON.parse(jsonText);
                var items = col.item || [];
                var requests = [];
                function extract(arr) {
                    arr.forEach(function(i) {
                        if (i.request) { requests.push(i); }
                        else if (i.item) { extract(i.item); }
                    });
                }
                extract(items);
                if (requests.length === 0) {
                    listEl.innerHTML = '<div class="list-group-item text-muted small">No request endpoints found inside collection.</div>';
                    return;
                }
                var pill = document.getElementById('postman-count-pill');
                if (pill) pill.innerText = requests.length + ' endpoints';

                var html = '';
                requests.forEach(function(r) {
                    var req = r.request;
                    var method = (req.method || 'GET').toUpperCase();
                    var url = typeof req.url === 'string' ? req.url : (req.url?.raw || req.url?.path?.join('/') || '');
                    var badgeClass = 'badge-' + method.toLowerCase();
                    html += '<div class="list-group-item d-flex align-items-center justify-content-between gap-3 py-2 px-3 border rounded mb-2">' +
                        '<div class="d-flex align-items-center gap-2">' +
                        '<span class="postman-req-badge ' + badgeClass + '">' + method + '</span>' +
                        '<strong>' + (r.name || url) + '</strong>' +
                        '</div>' +
                        '<code class="small text-muted">' + url + '</code>' +
                        '</div>';
                });
                listEl.innerHTML = html;
            } catch (e) {
                listEl.innerHTML = '<div class="list-group-item text-danger small">Could not parse requests from JSON: ' + e.message + '</div>';
            }
        }
        parsePostmanRequests();

        // Parse Environment Table
        var isEnvMasked = true;
        function parseDocEnvTable() {
            var tbody = document.getElementById('doc-env-table-body');
            if (!tbody) return;
            var raw = document.getElementById('doc-env-raw')?.innerText || '';
            var lines = raw.split('\n');
            var rows = '';
            lines.forEach(function(line) {
                line = line.trim();
                if (!line || line.startsWith('#')) return;
                var idx = line.indexOf('=');
                if (idx === -1) return;
                var key = line.substring(0, idx).trim();
                var val = line.substring(idx + 1).trim();
                var isSecret = /KEY|SECRET|PASSWORD|TOKEN|AUTH|CREDENTIAL|PRIVATE/i.test(key);

                rows += '<tr>' +
                    '<td class="font-monospace fw-bold text-success">' + key + '</td>' +
                    '<td><span class="' + (isSecret ? 'env-val env-val-secret masked' : 'env-val') + '" data-raw="' + val.replace(/"/g, '&quot;') + '">' + (isSecret ? '••••••••••••••••' : val) + '</span></td>' +
                    '<td style="text-align: right;"><button type="button" class="btn btn-outline-secondary btn-sm py-0" style="font-size: 11px;" onclick="copySingleEnv(\'' + val.replace(/'/g, "\\'") + '\', this)">Copy</button></td>' +
                    '</tr>';
            });
            tbody.innerHTML = rows || '<tr><td colspan="3" class="text-center text-muted small py-3">No valid KEY=VALUE lines found.</td></tr>';
        }

        function copySingleEnv(val, btn) {
            navigator.clipboard.writeText(val).then(function() {
                var orig = btn.innerText; btn.innerText = '✓'; setTimeout(() => btn.innerText = orig, 1200);
            });
        }

        function toggleDocEnvMasking(btn) {
            isEnvMasked = !isEnvMasked;
            document.querySelectorAll('#doc-env-table-body .env-val-secret').forEach(function(el) {
                if (isEnvMasked) {
                    el.classList.add('masked');
                    el.innerText = '••••••••••••••••';
                } else {
                    el.classList.remove('masked');
                    el.innerText = el.getAttribute('data-raw');
                }
            });
            if (btn) btn.innerText = isEnvMasked ? '👁 Show Secrets' : '🙈 Hide Secrets';
        }

        parseDocEnvTable();
    </script>
</body>
</html>

