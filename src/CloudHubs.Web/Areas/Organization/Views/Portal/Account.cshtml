@model CloudHubs.Web.ViewModels.Organizations.OrganizationAccountViewModel
@{
    Layout = null;
    var organization = Model.CurrentOrganization;
    var activeCategory = Model.SelectedCategory?.ToLowerInvariant();
    var isDetail = Model.IsCategoryDetailPage;

    var pageTitle = activeCategory switch
    {
        "workspace" => "Workspace Profile Settings",
        "api" => "Platform API & Custom Dashboard Settings",
        "subscription" => "Subscription Packages & Feature Unlocks",
        "profile" => "Admin Profile & Security Settings",
        _ => "Settings & Subscription Packages"
    };
    ViewData["Title"] = pageTitle;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - CloudHubs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
    <link rel="stylesheet" href="~/css/settings.css" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="admin-shell">
        <aside class="admin-sidebar organization-sidebar">
            <a class="brand" href="/organization">
                <span class="brand-mark">C</span>
                <span><strong>CloudHubs</strong><small>ORGANIZATION</small></span>
            </a>
            @if (organization is not null)
            {
                <p class="role-label">CURRENT ORGANIZATION</p>
                @if (Model.Organizations.Count > 1 || Model.CanShowOrganizationAction)
                {
                    <details class="workspace-top-dropdown">
                        <summary class="role-switch workspace-top-trigger" title="Click to switch workspace">
                            <span class="tenant-mark">@organization.Name[..Math.Min(organization.Name.Length, 2)].ToUpperInvariant()</span>
                            <span class="workspace-meta">
                                <strong>@organization.Name</strong>
                                <small>@organization.Role</small>
                            </span>
                            <span class="workspace-switch-badge">Switch ▾</span>
                        </summary>
                        <div class="workspace-top-menu">
                            <div class="workspace-menu-label">CURRENT WORKSPACE</div>
                            <div class="workspace-menu-item current">
                                <span class="tenant-mark-sm">@organization.Name[..Math.Min(organization.Name.Length, 2)].ToUpperInvariant()</span>
                                <span class="workspace-menu-name">@organization.Name</span>
                                <span class="workspace-check">✓</span>
                            </div>
                            @if (Model.Organizations.Count > 1)
                            {
                                <div class="workspace-menu-divider"></div>
                                <div class="workspace-menu-label">SWITCH WORKSPACE</div>
                                @foreach (var org in Model.Organizations.Where(item => item.Id != organization.Id))
                                {
                                    <form method="post" action="/organization/select" class="workspace-menu-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="organizationId" value="@org.Id" />
                                        <button class="workspace-menu-item" type="submit">
                                            <span class="tenant-mark-sm">@org.Name[..Math.Min(org.Name.Length, 2)].ToUpperInvariant()</span>
                                            <span class="workspace-menu-name">@org.Name</span>
                                        </button>
                                    </form>
                                }
                            }
                            <div class="workspace-menu-divider"></div>
                            @if (Model.CanShowOrganizationAction)
                            {
                                <a class="workspace-menu-item action-link" href="/organization/create">
                                    <span class="workspace-action-icon">+</span>
                                    <span>Add organization</span>
                                </a>
                            }
                            <form method="post" action="/organization/workspaces" class="workspace-menu-form">
                                @Html.AntiForgeryToken()
                                <button class="workspace-menu-item action-link" type="submit">
                                    <span class="workspace-action-icon">⊞</span>
                                    <span>View all workspaces</span>
                                </button>
                            </form>
                        </div>
                    </details>
                }
                else
                {
                    <div class="role-switch">
                        <span class="tenant-mark">@organization.Name[..Math.Min(organization.Name.Length, 2)].ToUpperInvariant()</span>
                        <span><strong>@organization.Name</strong><small>@organization.Role</small></span>
                    </div>
                }
                <nav class="side-nav" aria-label="Workspace sections">
                    <a class="side-link" href="/organization">Overview</a>
                    @if (Model.CanViewProjects)
                    {
                        <a class="side-link" href="/organization/projects">Projects</a>
                        <a class="side-link" href="/organization/merospace">MeroSpace</a>
                        <a class="side-link" href="/organization/tracker">Tracker</a>
                    }
                    <a class="side-link" href="/organization/docs">Docs</a>
                    @if (Model.CanViewMembers)
                    {
                        <a class="side-link" href="/organization/members">Members</a>
                    }
                    <a class="side-link active" href="/organization/settings" aria-current="page">Settings</a>
                </nav>
            }
            <div class="sidebar-spacer"></div>
            <div class="organization-sidebar-account">
                <span class="avatar">@((Model.UserName.Length > 0 ? Model.UserName[..1] : "U").ToUpperInvariant())</span>
                <span><strong>@Model.UserName</strong><small>@Model.UserEmail</small></span>
            </div>
        </aside>

        <main class="admin-main" id="main-content" tabindex="-1">
            <header class="topbar">
                <div class="breadcrumbs">
                    <a href="/organization" class="text-decoration-none text-muted">Workspace</a>
                    <span>/</span>
                    <a href="/organization" class="text-decoration-none text-muted">@(organization?.Name ?? "Organization")</a>
                    <span>/</span>
                    @if (isDetail)
                    {
                        <a href="/organization/settings" class="text-decoration-none text-muted">Settings</a>
                        <span>/</span>
                        <strong>@(activeCategory switch {
                            "workspace" => "Workspace Profile",
                            "api" => "Platform API & Custom Dashboard",
                            "subscription" => "Subscription & Packages",
                            "profile" => "Admin Profile & Security",
                            _ => "Settings Detail"
                        })</strong>
                    }
                    else
                    {
                        <strong>Settings &amp; Packages</strong>
                    }
                </div>
                <div class="heading-actions">
                    @if (isDetail)
                    {
                        <a href="/organization/settings" class="btn btn-outline-secondary btn-sm">← Back to All Settings</a>
                    }
                    else
                    {
                        <a href="/organization" class="btn btn-outline-secondary btn-sm">← Back to Overview</a>
                    }
                </div>
            </header>

            <div class="organization-content py-4 px-3 px-md-4">
                <div class="settings-container">
                    @if (TempData["Success"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="status">
                            <strong>Success:</strong> @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] is string errorMessage)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <strong>Error:</strong> @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!isDetail)
                    {
                        <!-- ========================================== -->
                        <!-- 1. SETTINGS HUB (SHOWS ONLY CATEGORY CARDS) -->
                        <!-- ========================================== -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                            <div>
                                <h1 class="h3 fw-bold mb-1">Organization Settings</h1>
                                <p class="text-muted small mb-0">Select a category below to configure your workspace, manage API credentials, upgrade packages, or edit admin security.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border">Plan: <strong class="text-success">@Model.SubscriptionPlan</strong></span>
                                <span class="badge bg-success">@Model.UserRole</span>
                            </div>
                        </div>

                        <!-- 4 Settings Category Cards -->
                        <div class="settings-cat-grid">
                            
                            <!-- Card 1: Workspace Profile -->
                            <a class="cat-card" href="/organization/settings/workspace">
                                <div>
                                    <div class="cat-card-header">
                                        <div class="cat-icon-wrap">🏢</div>
                                        <span class="cat-badge bg-success-subtle text-success border border-success-subtle">Active Org</span>
                                    </div>
                                    <h2 class="cat-card-title">Workspace Profile</h2>
                                    <p class="cat-card-desc">Organization identity, branding, slug, primary contact email &amp; custom API base URL.</p>
                                </div>
                                <div class="cat-card-footer">
                                    <span>@(organization?.Name ?? "Workspace Profile")</span>
                                    <span>Open Settings &rarr;</span>
                                </div>
                            </a>

                            <!-- Card 2: Platform API & Dashboard -->
                            <a class="cat-card" href="/organization/settings/api">
                                <div>
                                    <div class="cat-card-header">
                                        <div class="cat-icon-wrap">⚡</div>
                                        @if (Model.IsProOrCustomPlan || Model.HasApiAccess)
                                        {
                                            <span class="cat-badge bg-success text-white">Pro API Unlocked</span>
                                        }
                                        else
                                        {
                                            <span class="cat-badge bg-warning text-dark border">🔒 Pro Feature (Locked)</span>
                                        }
                                    </div>
                                    <h2 class="cat-card-title">Platform API &amp; Dashboard</h2>
                                    <p class="cat-card-desc">Master API keys, build your custom company dashboard, download Postman specs, and sync docs.</p>
                                </div>
                                <div class="cat-card-footer">
                                    <span>@(Model.IsProOrCustomPlan || Model.HasApiAccess ? "REST API Enabled ✓" : "🔒 Locked · Upgrade to Unlock")</span>
                                    <span>Open Settings &rarr;</span>
                                </div>
                            </a>

                            <!-- Card 3: Subscription & Packages -->
                            <a class="cat-card" href="/organization/settings/subscription">
                                <div>
                                    <div class="cat-card-header">
                                        <div class="cat-icon-wrap">💳</div>
                                        <span class="cat-badge bg-success-subtle text-success border border-success-subtle">@Model.SubscriptionPlan Tier</span>
                                    </div>
                                    <h2 class="cat-card-title">Subscription &amp; Packages</h2>
                                    <p class="cat-card-desc">Upgrade your package, unlock Platform API for custom dashboards, and expand project &amp; member limits.</p>
                                </div>
                                <div class="cat-card-footer">
                                    <span>Upgrade &amp; Unlock Features</span>
                                    <span>Open Settings &rarr;</span>
                                </div>
                            </a>

                            <!-- Card 4: Admin Profile & Security -->
                            <a class="cat-card" href="/organization/settings/profile">
                                <div>
                                    <div class="cat-card-header">
                                        <div class="cat-icon-wrap">👤</div>
                                        <span class="cat-badge bg-light text-dark border">@Model.UserRole</span>
                                    </div>
                                    <h2 class="cat-card-title">Admin Profile &amp; Security</h2>
                                    <p class="cat-card-desc">Personal administrator details, account email address, and account password security.</p>
                                </div>
                                <div class="cat-card-footer">
                                    <span>@Model.UserName</span>
                                    <span>Open Settings &rarr;</span>
                                </div>
                            </a>

                        </div>

                        <!-- Workspace Summary Stats Banner -->
                        <div class="p-4 bg-white border rounded-3 shadow-sm">
                            <h3 class="h6 fw-bold mb-3 text-secondary text-uppercase">Workspace Summary &amp; Health</h3>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="p-3 bg-light rounded border">
                                        <div class="text-muted small fw-bold">WORKSPACE SLUG</div>
                                        <div class="font-monospace fw-bold text-dark text-truncate">@Model.OrganizationSlug</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 bg-light rounded border">
                                        <div class="text-muted small fw-bold">ACTIVE SUBSCRIPTION</div>
                                        <div class="fw-bold text-success">@Model.SubscriptionPlan Tier</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 bg-light rounded border">
                                        <div class="text-muted small fw-bold">CUSTOM DASHBOARD API</div>
                                        <div class="fw-bold @(Model.IsProOrCustomPlan || Model.HasApiAccess ? "text-success" : "text-muted")">
                                            @(Model.IsProOrCustomPlan || Model.HasApiAccess ? "Active ✓" : "Locked (Pro/Custom)")
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 bg-light rounded border">
                                        <div class="text-muted small fw-bold">ADMINISTRATOR</div>
                                        <div class="fw-bold text-dark text-truncate">@Model.UserEmail</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- ========================================== -->
                        <!-- 2. DEDICATED SETTINGS CATEGORY DETAIL PAGE -->
                        <!-- ========================================== -->

                        @if (activeCategory == "workspace")
                        {
                            <!-- DEDICATED PAGE: WORKSPACE PROFILE -->
                            <section class="settings-card">
                                <div class="settings-card-header">
                                    <div>
                                        <h1 class="settings-card-title">🏢 Workspace Identity &amp; Profile</h1>
                                        <p class="settings-card-desc">Configure the public identity, branding, contact email, and custom API routing for <strong>@(organization?.Name ?? "Workspace")</strong>.</p>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">Active Organization</span>
                                </div>

                                @if (Model.CanManageOrganization && organization is not null)
                                {
                                    <form method="post" action="/organization/account/organization-profile">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="organizationId" value="@organization.Id" />

                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small" asp-for="OrganizationName">Organization / Company Name</label>
                                                <input asp-for="OrganizationName" class="form-control" required placeholder="e.g. Acme Corp" />
                                                <span asp-validation-for="OrganizationName" class="text-danger small"></span>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small" asp-for="OrganizationEmail">Primary Contact Email</label>
                                                <input asp-for="OrganizationEmail" class="form-control" type="email" required placeholder="contact@company.com" />
                                                <span asp-validation-for="OrganizationEmail" class="text-danger small"></span>
                                                <div class="form-text" style="font-size: 11px;">Receives workspace notices, invoices, and developer alerts.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small">Workspace Unique Slug</label>
                                                <input class="form-control font-monospace bg-light" value="@Model.OrganizationSlug" readonly disabled />
                                                <div class="form-text" style="font-size: 11px;">Permanent workspace identifier used for tenant subdomain routing and API paths.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold small" asp-for="OrganizationBaseApiUrl">Custom API Base URL (Optional)</label>
                                                <input asp-for="OrganizationBaseApiUrl" class="form-control" placeholder="https://api.yourdomain.com" />
                                                <span asp-validation-for="OrganizationBaseApiUrl" class="text-danger small"></span>
                                                <div class="form-text" style="font-size: 11px;">Custom domain proxy for your deployed backend microservices.</div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                            <a href="/organization/settings" class="btn btn-outline-secondary">← Back to Settings</a>
                                            <button type="submit" class="btn btn-success px-4">💾 Save Workspace Profile</button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <div class="alert alert-light border text-muted">
                                        <strong>View Only:</strong> You are currently signed in as <strong>@Model.UserRole</strong>. Only Organization Owners and Administrators can modify workspace profile settings.
                                    </div>
                                }
                            </section>
                        }
                        else if (activeCategory == "api")
                        {
                            <!-- DEDICATED PAGE: PLATFORM API & CUSTOM DASHBOARD -->
                            <div class="settings-card">
                                <div class="settings-card-header">
                                    <div>
                                        <h1 class="settings-card-title">⚡ CloudHubs Platform REST API &amp; Custom Dashboard</h1>
                                        <p class="settings-card-desc">Programmatic REST API provided by CloudHubs to query workspace hubs, projects, team members, and live documentation. Build your own external company dashboard or internal tooling.</p>
                                    </div>
                                    @if (Model.IsProOrCustomPlan || Model.HasApiAccess)
                                    {
                                        <span class="badge bg-success px-3 py-2">✓ API Access Unlocked (@Model.SubscriptionPlan)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">🔒 Locked (Pro / Custom Feature)</span>
                                    }
                                </div>

                                @if (!Model.IsProOrCustomPlan && !Model.HasApiAccess)
                                {
                                    <!-- LOCKED STATE: UPGRADE REQUIRED BANNER -->
                                    <div class="p-4 rounded-3 border-2 border-warning bg-warning-subtle text-dark mb-4 shadow-sm">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                            <div>
                                                <h2 class="h5 fw-bold mb-1">🔒 Platform REST API &amp; Custom Dashboard is Locked</h2>
                                                <p class="mb-0 small text-secondary">
                                                    Your workspace is currently on the <strong>@Model.SubscriptionPlan</strong> plan. The Master Organization API Key and custom dashboard integrations are unlocked exclusively for <strong>Pro</strong> ($49/mo) and <strong>Custom</strong> packages.
                                                </p>
                                            </div>
                                            <div>
                                                <form method="post" action="/organization/settings/upgrade-plan">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="planName" value="Pro" />
                                                    <button type="submit" class="btn btn-success fw-bold px-4 py-2">
                                                        🚀 Upgrade to Pro ($49/mo) &amp; Unlock All API Features
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Locked Mock Credentials Preview -->
                                    <div class="p-3 bg-light rounded border mb-4 opacity-75">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                            <div class="fw-bold small text-uppercase text-secondary">MASTER ORGANIZATION API KEY</div>
                                            <span class="badge bg-secondary">🔒 Locked</span>
                                        </div>
                                        <div class="api-key-box mb-2" style="background: #1e293b; color: #94a3b8;">
                                            <span>ch_live_•••••••••••••••••••••••••••••••• (Locked)</span>
                                        </div>
                                        <small class="text-danger" style="font-size: 11px;">🔒 Master API key generation and usage is locked on the Basic plan.</small>
                                    </div>

                                    <!-- Locked Base URL -->
                                    <div class="mb-4 opacity-75">
                                        <label class="form-label fw-bold small text-muted">PLATFORM BASE API ENDPOINT</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light font-monospace small">BASE URL</span>
                                            <input class="form-control font-monospace bg-light" value="@($"{Context.Request.Scheme}://{Context.Request.Host}/api/organizations/{organization?.Id}")" readonly disabled />
                                            <button class="btn btn-outline-secondary" type="button" disabled>🔒 Locked</button>
                                        </div>
                                        <div class="form-text text-muted" style="font-size: 11px;">External API calls to this base URL will return HTTP 401 Unauthorized without an active Pro or Custom package.</div>
                                    </div>

                                    <!-- Locked Action Cards -->
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 h-100 bg-light d-flex flex-column justify-content-between opacity-75">
                                                <div>
                                                    <h3 class="h6 fw-bold mb-1 text-secondary">⚡ View Organization API Hub (Docs)</h3>
                                                    <p class="text-muted small mb-3">Browse all 11 endpoints with interactive live parameter schemas, sample response payloads, and dashboard starter code.</p>
                                                </div>
                                                <div>
                                                    <button class="btn btn-secondary btn-sm w-100" disabled>
                                                        🔒 Locked &middot; Requires Pro Package
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 h-100 bg-light d-flex flex-column justify-content-between opacity-75">
                                                <div>
                                                    <h3 class="h6 fw-bold mb-1 text-secondary">📖 Move to Docs &amp; Set Member Access</h3>
                                                    <p class="text-muted small mb-3">Import this Platform API directly into your workspace Docs catalog and specify which team members can view it.</p>
                                                </div>
                                                <div>
                                                    <button class="btn btn-secondary btn-sm w-100" disabled>
                                                        🔒 Locked &middot; Requires Pro Package
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <button class="btn btn-outline-secondary btn-sm" disabled>
                                            🔒 Download Postman Collection (Requires Pro)
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <!-- UNLOCKED STATE: FULL PLATFORM API TOOLS -->
                                    <!-- Master Organization API Key Card -->
                                    <div class="p-3 bg-light rounded border mb-4">
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                            <div class="fw-bold small text-uppercase text-secondary">MASTER ORGANIZATION API KEY</div>
                                            <div class="d-flex align-items-center gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary py-1" onclick="toggleApiKeyVisibility()" id="btn-toggle-key">👁️ Show Key</button>
                                                <button type="button" class="btn btn-sm btn-outline-primary py-1" onclick="copyMasterKey()" id="btn-copy-key">📋 Copy Key</button>
                                            </div>
                                        </div>
                                        <div class="api-key-box mb-2">
                                            <span id="api-key-display" class="api-key-masked">
                                                @(string.IsNullOrWhiteSpace(Model.OrganizationApiKey) ? "No API key generated yet" : "••••••••••••••••••••••••••••••••••••••••••••")
                                            </span>
                                            <span id="api-key-real" style="display: none;">@Model.OrganizationApiKey</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                            <small class="text-muted" style="font-size: 11px;">Authenticate requests with <code>X-Api-Key: &lt;key&gt;</code> or <code>Authorization: Bearer &lt;key&gt;</code> header.</small>
                                            @if (organization is not null)
                                            {
                                                <form method="post" action="/organization/account/regenerate-api-key" onsubmit="return confirm('Regenerating this key will invalidate any active runners or custom dashboards using the old key. Proceed?');" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="organizationId" value="@organization.Id" />
                                                    <button type="submit" class="btn btn-link text-danger btn-sm p-0 text-decoration-none">🔄 Regenerate API Key</button>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                    <!-- Platform Base URL -->
                                    <div class="mb-4">
                                        <label class="form-label fw-bold small">PLATFORM BASE API ENDPOINT</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light font-monospace small">BASE URL</span>
                                            <input class="form-control font-monospace bg-white" id="platform-base-url" value="@($"{Context.Request.Scheme}://{Context.Request.Host}/api/organizations/{organization?.Id}")" readonly />
                                            <button class="btn btn-outline-secondary" type="button" onclick="copyBaseUrl()" id="btn-copy-base">Copy</button>
                                        </div>
                                    </div>

                                    <!-- Direct Action Cards: Docs Hub & Move to Docs -->
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 h-100 bg-white d-flex flex-column justify-content-between shadow-sm">
                                                <div>
                                                    <h3 class="h6 fw-bold mb-1 text-primary">⚡ View Organization API Hub (Docs)</h3>
                                                    <p class="text-muted small mb-3">Browse all 11 endpoints with interactive live parameter schemas, sample response payloads, and dashboard starter code.</p>
                                                </div>
                                                <div>
                                                    <a class="btn btn-primary btn-sm w-100" href="/organization/docs/api-hub">
