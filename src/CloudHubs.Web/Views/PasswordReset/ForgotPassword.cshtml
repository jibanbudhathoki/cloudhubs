@model CloudHubs.Web.ViewModels.Auth.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
    var errors = ViewData.ModelState.Values
        .SelectMany(state => state.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct()
        .ToArray();
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - CloudHubs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
</head>
<body class="login-page">
    <main class="login-shell">
        <a class="brand" href="/login">
            <span class="brand-mark">C</span>
            <span><strong>CloudHubs</strong><small>ACCOUNT RECOVERY</small></span>
        </a>
        <section class="login-panel">
            <p class="eyebrow">PASSWORD RESET</p>
            <h1>Forgot Password</h1>

            @if (Model.IsSubmitted)
            {
                <div class="alert alert-success mt-3" role="status">
                    <strong>Check your inbox.</strong>
                    <p class="mb-0 mt-1 small">@Model.ConfirmationMessage</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.DevResetLink))
                {
                    <div class="p-3 my-3 rounded" style="background: #e9f5ee; border: 1px dashed #28a745;">
                        <small class="text-uppercase fw-bold text-success d-block mb-1" style="font-size: 10px;">⚡ Development Environment Shortcut</small>
                        <p class="small text-muted mb-2">Since SMTP may not be configured in local dev, you can use the direct link below:</p>
                        <a href="@Model.DevResetLink" class="btn btn-sm btn-outline-success text-truncate d-block text-start font-monospace" style="font-size: 11px;">
                            👉 Proceed to Reset Password Form
                        </a>
                    </div>
                }

                <div class="mt-4 text-center">
                    <a href="/login" class="btn btn-outline-secondary w-100">Return to Sign In</a>
                </div>
            }
            else
            {
                <p>Enter the email address or member ID associated with your account and we will send you a link to reset your password.</p>

                @if (errors.Length > 0)
                {
                    <div class="alert alert-danger" role="alert" aria-live="assertive">
                        <ul class="mb-0">
                            @foreach (var error in errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post" action="/forgot-password" class="login-form">
                    @Html.AntiForgeryToken()
                    <label asp-for="Identifier">Email or Member ID</label>
                    <input asp-for="Identifier" class="form-control" autocomplete="username" placeholder="name@example.com or Member ID" required autofocus />
                    <span asp-validation-for="Identifier" class="text-danger small"></span>

                    <button class="btn btn-success w-100 mt-3" type="submit">Send Reset Link</button>
                </form>

                <div class="mt-4 p-3 rounded" style="background: #f8faf9; border: 1px solid #e1e7e4; font-size: 11.5px; color: #5a6560;">
                    <strong class="d-block text-dark mb-1" style="font-size: 11.5px;">💡 Account Recovery Tips</strong>
                    <ul class="ps-3 mb-0" style="line-height: 1.5;">
                        <li><strong>Forgot Member ID?</strong> You don't need it! You can sign in or reset your password using your <em>registered email address</em>.</li>
                        <li><strong>Forgot your Email?</strong> Enter your <em>Member ID</em> above and we'll dispatch the recovery link to your inbox.</li>
                        <li><strong>Forgot both?</strong> Ask any Administrator or Owner in your organization to look up your details in <strong>Organization &gt; Members</strong>.</li>
                    </ul>
                </div>

                <div class="text-center mt-3">
                    <a href="/login" class="login-back">← Back to Sign In</a>
                </div>
            }
        </section>
        <span class="login-back">Password reset links expire 2 hours after being requested.</span>
    </main>
</body>
</html>

