@model CloudHubs.Web.ViewModels.Projects.ProjectResourcesViewModel
@{
    Layout = null;
    ViewData["Title"] = $"{Model.ProjectName} - Docs & Integration";
    var currentOrganization = Model.CurrentOrganization!;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.ProjectName - Docs &amp; Developer Resources - CloudHubs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" />
    <link rel="stylesheet" href="~/css/projects.css" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="admin-shell">
        <aside class="admin-sidebar organization-sidebar">
            <a class="brand" href="/organization">
                <span class="brand-mark">C</span>
                <span><strong>CloudHubs</strong><small>ORGANIZATION</small></span>
            </a>
            <p class="role-label">CURRENT ORGANIZATION</p>
            @if (Model.Organizations.Count > 1 || Model.CanShowOrganizationAction)
            {
                <details class="workspace-top-dropdown">
                    <summary class="role-switch workspace-top-trigger" title="Click to switch workspace">
                        <span class="tenant-mark">@currentOrganization.Name[..Math.Min(currentOrganization.Name.Length, 2)].ToUpperInvariant()</span>
                        <span class="workspace-meta">
                            <strong>@currentOrganization.Name</strong>
                            <small>@currentOrganization.Role</small>
                        </span>
                        <span class="workspace-switch-badge">Switch ▾</span>
                    </summary>
                    <div class="workspace-top-menu">
                        <div class="workspace-menu-label">CURRENT WORKSPACE</div>
                        <div class="workspace-menu-item current">
                            <span class="tenant-mark-sm">@currentOrganization.Name[..Math.Min(currentOrganization.Name.Length, 2)].ToUpperInvariant()</span>
                            <span class="workspace-menu-name">@currentOrganization.Name</span>
                            <span class="workspace-check">✓</span>
                        </div>
                        @if (Model.Organizations.Count > 1)
                        {
                            <div class="workspace-menu-divider"></div>
                            <div class="workspace-menu-label">SWITCH WORKSPACE</div>
                            @foreach (var org in Model.Organizations.Where(item => item.Id != currentOrganization.Id))
                            {
                                <form method="post" action="/organization/select" class="workspace-menu-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="organizationId" value="@org.Id" />
                                    <button class="workspace-menu-item" type="submit">
                                        <span class="tenant-mark-sm">@org.Name[..Math.Min(org.Name.Length, 2)].ToUpperInvariant()</span>
                                        <span class="workspace-menu-name">@org.Name</span>
                                    </button>
                                </form>
                            }
                        }
                        <div class="workspace-menu-divider"></div>
                        @if (Model.CanShowOrganizationAction)
                        {
                            <a class="workspace-menu-item action-link" href="/organization/create">
                                <span class="workspace-action-icon">+</span>
                                <span>Add organization</span>
                            </a>
                        }
                        <form method="post" action="/organization/workspaces" class="workspace-menu-form">
                            @Html.AntiForgeryToken()
                            <button class="workspace-menu-item action-link" type="submit">
                                <span class="workspace-action-icon">⊞</span>
                                <span>View all workspaces</span>
                            </button>
                        </form>
                    </div>
                </details>
            }
            else
            {
                <div class="role-switch">
                    <span class="tenant-mark">@currentOrganization.Name[..Math.Min(currentOrganization.Name.Length, 2)].ToUpperInvariant()</span>
                    <span><strong>@currentOrganization.Name</strong><small>@currentOrganization.Role</small></span>
                </div>
            }
            <nav class="side-nav" aria-label="Workspace sections">
                <a class="side-link" href="/organization">Overview</a>
                <a class="side-link active" href="/organization/projects">Projects</a>
                <a class="side-link" href="/organization/merospace">MeroSpace</a>
                <a class="side-link" href="/organization/docs">Docs</a>
                @if (Model.CanViewMembers)
                {
                    <a class="side-link" href="/organization/members">Members</a>
                }
                <a class="side-link" href="/organization/settings">Settings</a>
            </nav>
            <div class="sidebar-spacer"></div>
            <div class="organization-sidebar-account">
                <span class="avatar">@((Model.UserName.Length > 0 ? Model.UserName[..1] : "U").ToUpperInvariant())</span>
                <span><strong>@Model.UserName</strong><small>@Model.UserEmail</small></span>
            </div>
        </aside>

        <main class="admin-main" id="main-content" tabindex="-1">
            <header class="topbar">
                <div class="breadcrumbs">
                    <a href="/organization">Workspace</a>
                    <span>/</span>
                    <a href="/organization">@currentOrganization.Name</a>
                    <span>/</span>
                    <a href="/organization/projects">Projects</a>
                    <span>/</span>
                    <strong>@Model.ProjectName &middot; Docs &amp; Integration</strong>
                </div>
                <div class="heading-actions">
                    <a class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" href="/organization/merospace/@Model.ProjectId" title="Open MeroSpace IDE">
                        <span>&#9654;</span> Launch MeroSpace
                    </a>
                    <a class="btn btn-outline-secondary btn-sm" href="/organization/projects">← Back to Projects</a>
                </div>
            </header>

            <div class="page-content organization-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="status">
                        @success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Project Hero Card -->
                <div class="res-hero">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="org-monogram" style="width: 44px; height: 44px; font-size: 16px;">
                                @(Model.ProjectTemplateId switch {
                                    "nodejs-mvc" => "MVC",
                                    "nodejs-modules" => "MOD",
                                    "go" => "GO",
                                    "java" => "JV",
                                    _ => "PR"
                                })
                            </span>
                            <div>
                                <h1 class="h4 mb-1 text-dark fw-bold">@Model.ProjectName</h1>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="template-badge badge-@Model.ProjectTemplateId">@Model.ProjectTemplateName</span>
                                    <span class="badge bg-light text-secondary border">slug: @Model.ProjectSlug</span>
                                    <span class="small text-muted">📁 <code>@Model.ProjectRootPath</code></span>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyShareUrl()" id="copy-share-btn">
                                🔗 Copy Share Link
                            </button>
                            <a class="btn btn-outline-secondary btn-sm" href="/organization/merospace/@Model.ProjectId/download">
                                ⬇ Download Code ZIP
                            </a>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.ProjectDescription))
                    {
                        <p class="text-secondary small mt-3 mb-0">@Model.ProjectDescription</p>
                    }
                </div>

                <!-- Navigation Tabs -->
                <ul class="nav res-nav-tabs" id="resourceTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="docs-tab" data-tab="docs" type="button" role="tab">
                            📖 Documentation &amp; Guides
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="postman-tab" data-tab="postman" type="button" role="tab">
                            🚀 Postman Collection
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="env-tab" data-tab="env" type="button" role="tab">
                            🔐 Environment Variables (.env)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="share-tab" data-tab="share" type="button" role="tab">
                            🤝 Team Quick Share &amp; API Key
                        </button>
                    </li>
                </ul>

                <!-- TAB 1: Documentation -->
                <div class="tab-pane-content" id="pane-docs">
                    <div class="res-card">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <div>
                                <h2 class="h5 mb-1 fw-bold">Project Documentation</h2>
                                <p class="text-muted small mb-0">Architecture notes, setup instructions, endpoints overview, and developer onboarding.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyDocumentation()" id="copy-docs-btn">
                                    📋 Copy Markdown
                                </button>
                                @if (Model.CanManageProjects)
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" onclick="toggleDocsEditor()" id="toggle-docs-btn">
                                        ✏️ Edit Documentation
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Read view -->
                        <div id="docs-view" class="docs-markdown p-3 bg-light rounded border">
                            @if (string.IsNullOrWhiteSpace(Model.Documentation))
                            {
                                <div class="text-center py-5 text-muted">
                                    <p class="h6">No documentation written yet.</p>
                                    <p class="small">Add project documentation, setup guides, or architectural notes for your team.</p>
                                    @if (Model.CanManageProjects)
                                    {
                                        <button type="button" class="btn btn-success btn-sm mt-2" onclick="toggleDocsEditor()">+ Add Documentation</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div id="docs-rendered-content"></div>
                            }
                        </div>

                        <!-- Edit form -->
                        @if (Model.CanManageProjects)
                        {
                            <form method="post" action="/organization/projects/@Model.ProjectId/resources" id="docs-form" style="display: none;" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PostmanCollection" value="@Model.PostmanCollection" />
                                <input type="hidden" name="EnvironmentVariables" value="@Model.EnvironmentVariables" />
                                <div class="mb-3">
                                    <label class="form-label fw-bold small" for="doc-textarea">Markdown Documentation</label>
                                    <textarea class="form-control font-monospace" id="doc-textarea" name="Documentation" rows="16" placeholder="# Project Documentation&#10;&#10;## Getting Started&#10;Explain setup steps here...&#10;&#10;## API Endpoints&#10;List endpoints here...">@Model.Documentation</textarea>
                                    <div class="form-text">Supports GitHub-flavored Markdown: headings (<code>#</code>), lists (<code>-</code>), code blocks (<code>```</code>), and links.</div>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleDocsEditor()">Cancel</button>
                                    <button type="submit" class="btn btn-success btn-sm">Save Documentation</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>

                <!-- TAB 2: Postman Collection -->
                <div class="tab-pane-content" id="pane-postman" style="display: none;">
                    <div class="res-card">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <div>
                                <h2 class="h5 mb-1 fw-bold">Postman Collection</h2>
                                <p class="text-muted small mb-0">Shareable API collection file compatible with Postman, Insomnia, Thunder Client, and Swagger.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(Model.PostmanCollection))
                                {
                                    <a class="btn btn-success btn-sm" href="/organization/projects/@Model.ProjectId/resources/download-postman">
                                        ⬇ Download Collection JSON
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyPostmanJson()" id="copy-postman-btn">
                                        📋 Copy JSON
                                    </button>
                                }
                                @if (Model.CanManageProjects)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="togglePostmanEditor()" id="toggle-postman-btn">
                                        @(string.IsNullOrWhiteSpace(Model.PostmanCollection) ? "+ Add Postman JSON" : "✏️ Edit Collection")
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Postman Request Explorer -->
                        <div id="postman-view">
                            @if (string.IsNullOrWhiteSpace(Model.PostmanCollection))
                            {
                                <div class="text-center py-5 text-muted bg-light rounded border">
                                    <p class="h6">No Postman collection configured yet.</p>
                                    <p class="small">Upload or paste your Postman Collection v2.1 JSON so developers can test and integrate endpoints instantly.</p>
                                    @if (Model.CanManageProjects)
                                    {
                                        <button type="button" class="btn btn-success btn-sm mt-2" onclick="togglePostmanEditor()">+ Paste Postman JSON</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <div class="alert alert-info py-2 small d-flex align-items-center justify-content-between">
                                        <span>💡 <strong>Quick Import:</strong> Open Postman &rarr; Click <strong>Import</strong> &rarr; Drop the downloaded JSON file or paste the copied JSON.</span>
                                        <a class="btn btn-sm btn-outline-primary py-0" href="/organization/projects/@Model.ProjectId/resources/download-postman">Download .json</a>
                                    </div>
                                    <h6 class="fw-bold small text-muted text-uppercase mb-2">Detected Endpoints in Collection</h6>
                                    <div id="postman-requests-list" class="list-group mb-3"></div>
                                </div>
                                <details>
                                    <summary class="btn btn-outline-secondary btn-sm">Show Raw Collection JSON</summary>
                                    <pre class="code-box mt-2" id="postman-raw-code">@Model.PostmanCollection</pre>
                                </details>
                            }
                        </div>

                        <!-- Edit form -->
                        @if (Model.CanManageProjects)
                        {
                            <form method="post" action="/organization/projects/@Model.ProjectId/resources" id="postman-form" style="display: none;" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Documentation" value="@Model.Documentation" />
                                <input type="hidden" name="EnvironmentVariables" value="@Model.EnvironmentVariables" />
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-bold small mb-0" for="postman-textarea">Postman Collection JSON (v2.0 or v2.1)</label>
                                        <button type="button" class="btn btn-link btn-sm text-decoration-none py-0" onclick="formatPostmanTextarea()">Format JSON</button>
                                    </div>
                                    <textarea class="form-control font-monospace" id="postman-textarea" name="PostmanCollection" rows="16" placeholder='{&#10;  "info": {&#10;    "name": "@Model.ProjectName API",&#10;    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"&#10;  },&#10;  "item": []&#10;}'>@Model.PostmanCollection</textarea>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="togglePostmanEditor()">Cancel</button>
                                    <button type="submit" class="btn btn-success btn-sm">Save Postman Collection</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>

                <!-- TAB 3: Environment Variables -->
                <div class="tab-pane-content" id="pane-env" style="display: none;">
                    <div class="res-card">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <div>
                                <h2 class="h5 mb-1 fw-bold">Environment Variables &amp; .env Config</h2>
                                <p class="text-muted small mb-0">Configuration keys, database URLs, port numbers, and environment variables needed to run the app.</p>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(Model.EnvironmentVariables))
                                {
                                    <a class="btn btn-success btn-sm" href="/organization/projects/@Model.ProjectId/resources/download-env">
                                        ⬇ Download .env
                                    </a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyEnvText()" id="copy-env-btn">
                                        📋 Copy .env
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleSecretMasking()" id="mask-env-btn">
                                        👁 Toggle Secret Masking
                                    </button>
                                }
                                @if (Model.CanManageProjects)
                                {
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="toggleEnvEditor()" id="toggle-env-btn">
                                        @(string.IsNullOrWhiteSpace(Model.EnvironmentVariables) ? "+ Add .env Variables" : "✏️ Edit .env")
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- Read view: Parsed Table -->
                        <div id="env-view">
                            @if (string.IsNullOrWhiteSpace(Model.EnvironmentVariables))
                            {
                                <div class="text-center py-5 text-muted bg-light rounded border">
                                    <p class="h6">No environment variables defined yet.</p>
                                    <p class="small">Add sample <code>.env</code> key-value pairs (e.g. <code>PORT=3000</code>, <code>DATABASE_URL=...</code>) to help developers configure their local setups.</p>
                                    @if (Model.CanManageProjects)
                                    {
                                        <button type="button" class="btn btn-success btn-sm mt-2" onclick="toggleEnvEditor()">+ Add Environment Variables</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive border rounded mb-3">
                                    <table class="env-table">
                                        <thead>
                                            <tr>
                                                <th style="width: 35%;">VARIABLE</th>
                                                <th>VALUE</th>
                                                <th style="width: 80px; text-align: right;">ACTION</th>
                                            </tr>
                                        </thead>
                                        <tbody id="env-table-body"></tbody>
                                    </table>
                                </div>
                                <details>
                                    <summary class="btn btn-outline-secondary btn-sm">Show Raw .env Text</summary>
                                    <pre class="code-box mt-2" id="env-raw-code">@Model.EnvironmentVariables</pre>
                                </details>
                            }
                        </div>

                        <!-- Edit form -->
                        @if (Model.CanManageProjects)
                        {
                            <form method="post" action="/organization/projects/@Model.ProjectId/resources" id="env-form" style="display: none;" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Documentation" value="@Model.Documentation" />
                                <input type="hidden" name="PostmanCollection" value="@Model.PostmanCollection" />
                                <div class="mb-3">
                                    <label class="form-label fw-bold small" for="env-textarea">Raw .env File Content (KEY=VALUE per line)</label>
                                    <textarea class="form-control font-monospace" id="env-textarea" name="EnvironmentVariables" rows="14" placeholder="PORT=3000&#10;NODE_ENV=development&#10;DATABASE_URL=postgres://user:pass@localhost:5432/db&#10;API_KEY=your_key_here">@Model.EnvironmentVariables</textarea>
                                    <div class="form-text">Lines starting with <code>#</code> are treated as comments. Secret values with words like <code>KEY</code>, <code>SECRET</code>, <code>PASSWORD</code>, <code>TOKEN</code> can be masked in the viewer.</div>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleEnvEditor()">Cancel</button>
                                    <button type="submit" class="btn btn-success btn-sm">Save .env Variables</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>

                <!-- TAB 4: Team Quick Share & API Key -->
                <div class="tab-pane-content" id="pane-share" style="display: none;">
                    <div class="res-card">
                        <h2 class="h5 mb-2 fw-bold">Team Quick Share &amp; Integration Guide</h2>
                        <p class="text-muted small mb-4">Everything a frontend developer, mobile engineer, or team member needs to connect and integrate with this project.</p>

                        <div class="row g-4">
                            <!-- Share Link -->
                            <div class="col-md-6">
                                <div class="p-3 border rounded h-100 bg-light">
                                    <h6 class="fw-bold mb-2">🔗 Direct Developer Resource Link</h6>
                                    <p class="text-muted small mb-2">Share this URL with any team member in @currentOrganization.Name to give them instant access to docs, postman collections, and .env files:</p>
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control form-control-sm font-monospace" id="share-link-input" readonly />
                                        <button class="btn btn-outline-success btn-sm" type="button" onclick="copyShareUrl()" id="share-link-btn">Copy Link</button>
                                    </div>
                                    <small class="text-muted">Only authorized members of @currentOrganization.Name can view and access this project.</small>
                                </div>
                            </div>

                            <!-- Organization API Key -->
                            <div class="col-md-6">
                                <div class="p-3 border rounded h-100 bg-light">
                                    <h6 class="fw-bold mb-2">🔑 Organization API Key</h6>
                                    <p class="text-muted small mb-2">Use this key in HTTP requests to authenticate against CloudHubs organization endpoints:</p>
                                    @if (!string.IsNullOrWhiteSpace(Model.OrganizationApiKey))
                                    {
                                        <div class="input-group mb-2">
                                            <input type="text" class="form-control form-control-sm font-monospace" id="org-api-key-input" value="@Model.OrganizationApiKey" readonly />
                                            <button class="btn btn-outline-success btn-sm" type="button" onclick="copyApiKey()" id="api-key-btn">Copy Key</button>
                                        </div>
                                        <small class="text-muted">Include this in headers: <code>Authorization: Bearer @Model.OrganizationApiKey</code> or <code>X-Api-Key: @Model.OrganizationApiKey</code></small>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning py-2 small mb-0">
                                            No API key generated yet. Generate one in <a href="/organization/account" class="fw-bold">My Account</a>.
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Integration Snippet -->
                            <div class="col-12">
                                <div class="p-3 border rounded bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h6 class="fw-bold mb-0">💻 Sample cURL Request with API Key</h6>
                                        <button class="btn btn-outline-secondary btn-sm py-0" onclick="copyCurlSnippet()" id="curl-copy-btn">Copy cURL</button>
                                    </div>
                                    <pre class="code-box mb-0" id="curl-snippet">curl -X GET "http://127.0.0.1:8000/api/projects/@Model.ProjectSlug" \
  -H "Accept: application/json" \
  -H "Authorization: Bearer @(string.IsNullOrWhiteSpace(Model.OrganizationApiKey) ? "YOUR_CLOUDHUBS_API_KEY" : Model.OrganizationApiKey)"</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/portal.js"></script>
    <script src="~/js/projects.js"></script>
</body>
</html>

