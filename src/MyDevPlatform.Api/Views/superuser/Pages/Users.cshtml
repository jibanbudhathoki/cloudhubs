@model UserIndexViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    ViewData["Title"] = "Users";
    ViewData["Section"] = "Users";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">CONTROL PLANE / USERS</p>
        <h1>Users</h1>
        <p>Platform user records and assigned platform roles.</p>
    </div>
    <a class="btn btn-success" href="/su/users/create">Create user</a>
</section>

<div class="alert alert-info" role="note">The platform Superuser account is bootstrapped from environment credentials. Other platform user records do not yet provision sign-in credentials or organization membership.</div>

@if (!Model.IsDataAvailable)
{
    <div class="alert alert-warning" role="status">@Model.ErrorMessage</div>
}

<section class="surface">
    <div class="surface-heading">
        <div><h2 id="user-list-title">Platform users</h2><p>Search by name, email, or role.</p></div>
        <span class="count" aria-label="@Model.Users.Count users found">@Model.Users.Count</span>
    </div>
    <form class="organization-search" method="get" action="/su/users" role="search" aria-labelledby="user-list-title">
        <label class="visually-hidden" for="user-query">Search users</label>
        <input class="form-control" id="user-query" name="query" type="search" value="@Model.Query" placeholder="Search users…" autocomplete="off" />
        <button class="btn btn-success" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <a class="btn btn-outline-secondary" href="/su/users">Clear</a>
        }
    </form>
    <p class="visually-hidden" role="status" aria-live="polite">@Model.Users.Count users found.</p>
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success mx-3" role="status">@successMessage</div>
    }
    @if (Model.Users.Count > 0)
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Platform users with role and active status</caption>
                <thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><div class="org-cell"><span class="org-monogram">@string.Concat(user.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => word[0]))</span><span><strong>@user.Name</strong><small class="org-email">@(user.LoginId ?? user.Email)</small></span></div></td>
                            <td>@user.Role</td>
                            <td><span class="status @(user.IsActive ? "status-active" : "status-suspended")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                            <td>
                                @if (user.Role != MyDevPlatform.Domain.Users.UserRole.Superuser)
                                {
                                    <div class="table-actions"><a class="btn btn-sm btn-outline-secondary" href="/su/users/@user.Id/edit">Edit</a><form method="post" action="/su/users/@user.Id/delete" onsubmit="return confirm('Delete this user?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state"><strong>@(!Model.IsDataAvailable ? "User data unavailable" : Model.Query is not null ? "No matching users" : "No users yet")</strong><span>@(!Model.IsDataAvailable ? "Check the database connection, then reload this page." : Model.Query is not null ? "Try a different search term or clear the filter." : "Create the first platform user record.")</span></div>
    }
</section>