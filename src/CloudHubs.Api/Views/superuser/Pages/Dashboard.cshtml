@model SuperuserDashboardViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    ViewData["Title"] = "Overview";
    var activeCount = Model.Organizations.Count(item => string.Equals(item.Status, "Active", StringComparison.OrdinalIgnoreCase));
    var trialCount = Model.Organizations.Count(item => string.Equals(item.SubscriptionStatus, "Trial", StringComparison.OrdinalIgnoreCase));
    ViewData["Section"] = "Overview";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">CONTROL PLANE / OVERVIEW</p>
        <h1>Superuser dashboard</h1>
        <p>Platform-wide organization management and service overview.</p>
    </div>
    <a class="btn btn-success" href="/su/organization">Manage organizations</a>
</section>

@if (!Model.IsApiAvailable)
{
    <div class="alert alert-warning" role="status">@Model.ErrorMessage</div>
}

<section class="stats-grid" aria-label="Organization summary">
    <article class="stat-card"><span class="stat-label">Organizations</span><strong>@(Model.IsApiAvailable ? Model.Organizations.Count.ToString() : "-")</strong><small>Registered accounts</small></article>
    <article class="stat-card"><span class="stat-label">Active</span><strong>@(Model.IsApiAvailable ? activeCount.ToString() : "-")</strong><small>Enabled organizations</small></article>
    <article class="stat-card"><span class="stat-label">Trials</span><strong>@(Model.IsApiAvailable ? trialCount.ToString() : "-")</strong><small>Trial subscriptions</small></article>
    <article class="stat-card"><span class="stat-label">Platform API</span><strong class="api-state">@(Model.IsApiAvailable ? "Online" : "Offline")</strong><small>Organization data source</small></article>
</section>

<section id="organizations" class="surface">
    <div class="surface-heading">
        <div>
            <h2>Organizations</h2>
            <p>Accounts registered on CloudHubs</p>
        </div>
        <a class="count" href="/su/organization">View all @Model.Organizations.Count</a>
    </div>
    @if (Model.Organizations.Count > 0)
    {
        @await Html.PartialAsync("~/Views/superuser/Components/_OrganizationTable.cshtml", Model.Organizations.Take(5).ToArray())
    }
    else
    {
        <div class="empty-state">
            <strong>@(Model.IsApiAvailable ? "No organizations yet" : "Organization data unavailable")</strong>
            <span>@(Model.IsApiAvailable ? "New accounts will appear here." : "Start the database and reload this page.")</span>
        </div>
    }
</section>

<footer class="page-foot">
    <span>Superuser control plane</span>
    <span>@(Model.IsApiAvailable ? "Live organization data" : "Waiting for database connection")</span>
</footer>