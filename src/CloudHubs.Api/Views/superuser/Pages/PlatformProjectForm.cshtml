@model PlatformProjectFormViewModel
@{
    Layout = "~/Views/superuser/Shared/_Layout.cshtml";
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit platform project" : "Create platform project";
    ViewData["Section"] = "Projects";
}

<section class="page-heading">
    <div><p class="eyebrow">CONTROL PLANE / PLATFORM PROJECTS</p><h1>@ViewData["Title"]</h1><p>This project is owned by CloudHubs and is not attached to an organization.</p></div>
    <a class="btn btn-outline-secondary" href="/su/projects">Back to projects</a>
</section>

<form class="surface admin-form" method="post" action="@(isEdit ? $"/su/projects/{Model.Id}/edit" : "/su/projects/create")">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" asp-validation-summary="All" role="alert"></div>
    }
    <div class="alert alert-info" role="note">No organization is created or required for this project.</div>
    <div class="mb-3"><label class="form-label" asp-for="Name">Project name</label><input class="form-control" asp-for="Name" autocomplete="off" required /><span class="text-danger" asp-validation-for="Name"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Slug">Slug</label><input class="form-control" asp-for="Slug" autocapitalize="none" spellcheck="false" required /><span class="text-danger" asp-validation-for="Slug"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="Description">Description</label><textarea class="form-control" asp-for="Description" rows="3"></textarea><span class="text-danger" asp-validation-for="Description"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="RootPath">Root path</label><input class="form-control" asp-for="RootPath" placeholder="platform/my-project" required /><span class="text-danger" asp-validation-for="RootPath"></span></div>
    <div class="mb-3"><label class="form-label" asp-for="TemplateId">Template ID</label><input class="form-control" asp-for="TemplateId" required /><span class="text-danger" asp-validation-for="TemplateId"></span></div>
    <div class="form-check mb-4"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">Active</label></div>
    <div class="form-actions"><a class="btn btn-outline-secondary" href="/su/projects">Cancel</a><button class="btn btn-success" type="submit">@(isEdit ? "Save changes" : "Create project")</button></div>
</form>